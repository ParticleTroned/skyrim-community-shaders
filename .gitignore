build/
artifacts/
bin/
dist/
/vcpkg/
/vcpkg_installed/
/*/vcpkg_cache/
# Persistent local release archives; unlike dist/, CMake packaging does not own
# or recreate this directory.
/artifacts/releases/
.idea/
.vs*/
CMakeUserPresets.json
shadertoolsconfig.json
.vscode

# Folder view configuration files
**/.DS_Store
.claude/settings.local.json

# Shader test artifacts
tests/shaders/build/
tests/shaders/*.exe
tests/shaders/*.pdb
tests/shaders/Shaders/
# Streamline runtime modules are copied during local builds
features/Upscaling/Shaders/Upscaling/Streamline/sl.pcl.dll
features/Upscaling/Shaders/Upscaling/Streamline/sl.reflex.dll
**/__pycache__/

# Unified-preset generator ownership and crash-recovery state
/.csx-unified-presets.lock
/.csx-unified-presets.transaction.json
/.csx-unified-presets.transaction.json.tmp
# Developer-supplied Streamline and NGX runtimes never enter source control
/features/Upscaling/Shaders/Upscaling/Streamline/**/*.[dD][lL][lL]
tools/__pycache__/
tools/nr-color/__pycache__/
tests/neural_color/__pycache__/

# Historical gameft copies stay local while automation owns the toolchain.
/tools/gameft-sw/
/tests/gameft_stack_wait_test.ps1
