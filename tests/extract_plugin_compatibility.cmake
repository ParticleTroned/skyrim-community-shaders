file(READ "${PROJECT_ROOT}/src/XSEPlugin.cpp" _plugin)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
include("${PROJECT_ROOT}/tests/extract_source_region.cmake")
extract_between("${_plugin}" "\tvoid PushStartupError(" "\n\tvoid CommunityShadersAPIMessageHandler(" "plugin_compatibility_under_test.h")

# These placement checks complement the startup-helper behavior coverage.
foreach(_phase IN ITEMS Load PostLoad PostPostLoad DataLoaded)
    if(_phase STREQUAL "Load")
        set(_start "bool Load()\n{")
        set(_guard "if (errors.empty())")
        set(_consumer "Hooks::InstallEarlyHooks();")
    elseif(_phase STREQUAL "PostLoad")
        set(_start "case SKSE::MessagingInterface::kPostLoad:")
        set(_guard "if (!errors.empty())")
        set(_consumer "CSX::Api::ScheduleRuntimeMainThreadBinding();")
    elseif(_phase STREQUAL "PostPostLoad")
        set(_start "case SKSE::MessagingInterface::kPostPostLoad:")
        set(_guard "if (errors.empty())")
        set(_consumer "Deferred::Hooks::Install();")
    else()
        set(_start "case SKSE::MessagingInterface::kDataLoaded:")
        set(_guard "if (errors.empty())")
        set(_consumer "globals::OnDataLoaded();")
    endif()
    string(FIND "${_plugin}" "${_start}" _begin)
    if(_begin EQUAL -1)
        message(FATAL_ERROR "Missing ${_phase} lifecycle handler")
    endif()
    string(SUBSTRING "${_plugin}" ${_begin} -1 _body)
    if(NOT _phase STREQUAL "Load")
        string(SUBSTRING "${_body}" 5 -1 _tail)
        string(FIND "${_tail}" "case SKSE::MessagingInterface::" _next_case)
        if(NOT _next_case EQUAL -1)
            math(EXPR _end "${_next_case} + 5")
            string(SUBSTRING "${_body}" 0 ${_end} _body)
        endif()
    endif()
    string(FIND "${_body}" "CheckIncompatiblePlugins();" _check)
    string(FIND "${_body}" "${_guard}" _gate)
    string(FIND "${_body}" "${_consumer}" _initialization)
    if(_phase STREQUAL "Load")
        string(FIND "${_body}" "globals::OnInit();" _globals)
        if(_globals EQUAL -1 OR _check GREATER _globals)
            message(FATAL_ERROR "Load must report conflicts before initializing CSX globals")
        endif()
    endif()
    if(_check EQUAL -1 OR _gate EQUAL -1 OR _initialization EQUAL -1 OR _check GREATER _gate OR _gate GREATER _initialization)
        message(FATAL_ERROR "${_phase} must detect and gate conflicts before initialization")
    endif()
endforeach()
