if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
file(READ "${PROJECT_ROOT}/src/Features/Wetterness/SnowMelt.cpp" source)
string(FIND "${source}" "namespace WetternessSnowMelt" start)
if(start EQUAL -1)
    message(FATAL_ERROR "Snowmelt runtime namespace not found")
endif()
string(SUBSTRING "${source}" ${start} -1 source)
file(WRITE "${OUTPUT_DIRECTORY}/snow_melt_runtime.h" "${source}")
