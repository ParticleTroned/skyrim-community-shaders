if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()

function(extract SOURCE START END OUTPUT)
    string(FIND "${SOURCE}" "${START}" FIRST)
    string(FIND "${SOURCE}" "${END}" LAST)
    if(FIRST EQUAL -1 OR LAST LESS FIRST)
        message(FATAL_ERROR "Cannot locate skin transmission test input: ${OUTPUT}")
    endif()
    math(EXPR LENGTH "${LAST} - ${FIRST}")
    string(SUBSTRING "${SOURCE}" ${FIRST} ${LENGTH} CONTENT)
    file(WRITE "${OUTPUT_DIRECTORY}/${OUTPUT}" "${CONTENT}")
endfunction()

file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
file(READ "${PROJECT_ROOT}/src/Features/Skin.h" HEADER)
extract("${HEADER}" "\tstruct Settings" "\t/** Prepares actor" "skin_transmission_data.h")
file(READ "${PROJECT_ROOT}/src/Features/Skin.cpp" SOURCE)
extract("${SOURCE}" "Skin::SkinData Skin::GetCommonBufferData() const" "bool Skin::IsWetnessEnabled() const" "skin_transmission_packing.h")
