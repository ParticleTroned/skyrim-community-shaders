include("${PROJECT_ROOT}/tests/extract_source_region.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
file(READ "${PROJECT_ROOT}/src/Features/LightLimitFix.h" header)
extract_between("${header}" "\tusing PointShadowMode =" "\n\tvirtual inline std::string GetName" "point_shadow_accessors.h")
extract_between("${header}" "\tstruct Settings\n" "\n\tuint clusterSize" "point_shadow_settings.h")
extract_between("${header}" "\t/** Includes deferred shadow" "\n\tvirtual void DrawOverlay" "point_shadow_performance.h")
file(READ "${OUTPUT_DIRECTORY}/point_shadow_performance.h" performance)
string(REPLACE "virtual " "" performance "${performance}")
string(REPLACE " override" "" performance "${performance}")
file(WRITE "${OUTPUT_DIRECTORY}/point_shadow_performance.h" "${performance}")
file(READ "${PROJECT_ROOT}/src/Features/LightLimitFix.cpp" source)
extract_between("${source}" "\tconstexpr uint kContactShadowFlagPoint" "\n\tconstexpr std::uint32_t kParticleLightCacheSweepInterval" "point_shadow_constants.h")
extract_between("${source}" "\tvoid SanitizeSettings(" "\n\tuint PackContactShadowFlags" "point_shadow_sanitize.h")
extract_between("${source}" "NLOHMANN_DEFINE_TYPE_NON_INTRUSIVE_WITH_DEFAULT(" "\nvoid LightLimitFix::DrawSettings" "point_shadow_serialization.h")
extract_between("${source}" "bool LightLimitFix::IsPointShadowCorrectionAvailable()" "\nvoid LightLimitFix::DrawPerformanceSettings" "point_shadow_publication.h")
extract_between("${source}" "bool LightLimitFix::IsPerformanceCostMeasurementReady()" "\nvoid LightLimitFix::DrawOverlay" "point_shadow_capture.h")
extract_between("${source}" "void LightLimitFix::ReplaceSettings(" "\nRE::NiNode* GetParentRoomNode" "point_shadow_load.h")
file(READ "${PROJECT_ROOT}/src/Api/FeatureDevBenchBridge.cpp" bridge)
extract_between("${bridge}" "\tjson ControlPointShadowCorrection(" "\n\tjson BuildResult(" "point_shadow_api.h")
extract_between("${bridge}" "\tjson BuildResult(" "\n\t\tif (args.contains(\"alphaPassIntegrity\")" "point_shadow_dispatch_start.h")
extract_between("${bridge}" "\t\tif (action == \"point_shadow_correction\") {" "\n\t\tif (args.contains(\"lightAttach\")" "point_shadow_dispatch_action.h")
foreach(required IN ITEMS
    "AddPointShadowCorrectionSchema(spec);"
    "response[\"result\"][\"actions\"].push_back(\"point_shadow_correction\");"
    "if (args.contains(\"pointShadowCorrection\") && action != \"point_shadow_correction\")"
    "return ControlPointShadowCorrection(args);"
    "\"request\", false, \"pointShadowCorrection\"")
    string(FIND "${bridge}" "${required}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Missing point-shadow bridge integration: ${required}")
    endif()
endforeach()

file(READ "${PROJECT_ROOT}/src/State.cpp" state)
string(FIND "${state}" "void State::Reset()" start)
string(SUBSTRING "${state}" ${start} -1 reset)
string(FIND "${reset}" "UpdateSaveLoadSafeMode();" safety)
string(FIND "${reset}" "ApplyPointShadowCorrection();" publication)
if(safety LESS 0 OR publication LESS safety)
    message(FATAL_ERROR "Point-shadow publication must follow the current frame's save/load and menu update")
endif()
