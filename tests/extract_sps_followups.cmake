include("${CMAKE_CURRENT_LIST_DIR}/extract_source_region.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
file(READ "${PROJECT_ROOT}/src/Features/LightLimitFix/ShadowCulling.cpp" source)
extract_between("${source}" "\tvoid Install()" "\tvoid Update(" "shadow_startup_under_test.h")
extract_between("${source}" "\t\tbool HasEligibleCamera(" "\t\tvoid CaptureLight(" "shadow_eligibility_under_test.h")
file(READ "${PROJECT_ROOT}/src/Features/LightLimitFix.h" source)
extract_between("${source}" "\tstruct Settings\n" "\n\tuint clusterSize" "shadow_controls_under_test.h")
file(READ "${OUTPUT_DIRECTORY}/shadow_controls_under_test.h" settings)
string(REPLACE " override" "" source "${source}")
string(REPLACE "virtual " "" source "${source}")
string(REPLACE "\tbool IsPerformanceCostMeasurementReady() const;\n" "" source "${source}")
extract_between("${source}" "\tbool IsPerformanceToggleEnabled()" "\tvoid DrawOverlay()" "shadow_controls_under_test.h")
file(READ "${OUTPUT_DIRECTORY}/shadow_controls_under_test.h" controls)
file(WRITE "${OUTPUT_DIRECTORY}/shadow_controls_under_test.h" "${settings}\nSettings settings;\n${controls}")
