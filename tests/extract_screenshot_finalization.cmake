extract_finalization_method([==[std::size_t ScreenshotApi::CountPendingOperationsLocked()]==] "\n}")
extract_finalization_method([==[void ScreenshotApi::TryFinalizeSequenceLocked(]==] "\n}")
extract_finalization_method([==[void ScreenshotApi::FailSequenceFinalizationLocked(]==] "\n}")
extract_finalization_method([==[void ScreenshotApi::FinalizeSequenceLocked(]==] "\n}")
extract_finalization_method([==[void ScreenshotApi::QueueSequenceManifestLocked(]==] "\n}")
extract_finalization_method([==[void ScreenshotApi::DrainReferenceNotifications()]==] "\n}")
extract_finalization_method([==[json DescribeCommittedArtifact(]==] "\n\t}")
extract_finalization_method([==[bool HasCompleteArtifactProvenance(]==] "\n\t}")
extract_finalization_method([==[void ScreenshotApi::FailRequestCompletionLocked(]==] "\n}")
extract_finalization_method([==[void ScreenshotApi::FinishSequenceChildLocked(]==] "\n}")
extract_finalization_method([==[void ScreenshotApi::OnArtifactTerminal(]==] "\n}")
