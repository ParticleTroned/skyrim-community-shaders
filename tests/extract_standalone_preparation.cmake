if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()
include("${PROJECT_ROOT}/tests/extract_source_region.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
file(READ "${PROJECT_ROOT}/src/ShaderCache.cpp" _cache)
extract_between("${_cache}" "\tbool ShaderCache::IsStandalonePreparationCurrent" "\n\tbool ShaderCache::CompileStandaloneShaderCached" "standalone_preparation_under_test.h")
extract_between("${_cache}" "\tbool ShaderCache::IsCompiling()" "\n\tvoid ShaderCache::TryCompleteStartupCompilationPhase" "standalone_compiling_under_test.h")
extract_between("${_cache}" "\tvoid ShaderCache::StopCompilation()" "\n\tbool ShaderCache::IsEnabled()" "standalone_stop_under_test.h")
extract_between("${_cache}" "\tShaderCache::~ShaderCache()" "\n\t\t// Stop dispatch before" "standalone_shutdown_under_test.h")
file(READ "${OUTPUT_DIRECTORY}/standalone_shutdown_under_test.h" _shutdown)
string(REPLACE "ShaderCache::~ShaderCache()" "void ShaderCache::Shutdown()" _shutdown "${_shutdown}")
file(WRITE "${OUTPUT_DIRECTORY}/standalone_shutdown_under_test.h" "${_shutdown}\n\t}\n")
