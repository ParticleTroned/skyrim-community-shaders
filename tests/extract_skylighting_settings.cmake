if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_FILE)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_FILE are required")
endif()

file(READ "${PROJECT_ROOT}/src/Features/Skylighting.cpp" _source)
file(READ "${PROJECT_ROOT}/src/Features/Skylighting.h" _header)
string(FIND "${_header}" "\tstruct Settings\n" _start)
if(_start EQUAL -1)
    message(FATAL_ERROR "Skylighting settings test cannot find the settings type")
endif()
string(SUBSTRING "${_header}" ${_start} -1 _remaining)
string(FIND "${_remaining}" "\n\t} settings;" _end)
if(_end EQUAL -1)
    message(FATAL_ERROR "Skylighting settings test cannot find the settings boundary")
endif()
math(EXPR _length "${_end} + 3")
string(SUBSTRING "${_remaining}" 0 ${_length} _settings)
set(_implementation "struct Skylighting {\n${_settings};\n};\n")

string(FIND "${_source}" "\tstruct ProbeGridPreset\n" _start)
string(FIND "${_source}" "\tstruct SkylightingPerformancePreset\n" _end)
if(_start LESS 0 OR _end LESS _start)
    message(FATAL_ERROR "Skylighting settings test cannot find the probe presets")
endif()
math(EXPR _length "${_end} - ${_start}")
string(SUBSTRING "${_source}" ${_start} ${_length} _presets)
string(APPEND _implementation "${_presets}\n")

function(append_settings_function signature)
    string(FIND "${_source}" "${signature}" _start)
    if(_start LESS 0)
        message(FATAL_ERROR "Skylighting settings test cannot find ${signature}")
    endif()
    string(SUBSTRING "${_source}" ${_start} -1 _remaining)
    string(FIND "${_remaining}" "\n\t}\n" _end)
    if(_end LESS 0)
        message(FATAL_ERROR "Skylighting settings test cannot find the end of ${signature}")
    endif()
    math(EXPR _length "${_end} + 4")
    string(SUBSTRING "${_remaining}" 0 ${_length} _function)
    set(_implementation "${_implementation}\n${_function}" PARENT_SCOPE)
endfunction()

append_settings_function("uint ClampProbeGridQuality(")
append_settings_function("uint ClampUpdateInterval(")
append_settings_function("float ClampProbeFieldSize(")
append_settings_function("uint ClampProbeUpdateIntervalAgainstOcclusion(")
append_settings_function("void NormalizeSettingsForRuntime(")
get_filename_component(_output_directory "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${_output_directory}")
file(WRITE "${OUTPUT_FILE}" "${_implementation}\n")
