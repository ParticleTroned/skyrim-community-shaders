include("${PROJECT_ROOT}/tests/extract_source_region.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
foreach(_consumer IN ITEMS Effect Particle Water)
    file(READ "${PROJECT_ROOT}/package/Shaders/${_consumer}.hlsl" _source)
    string(FIND "${_source}" "float3 lightDirection = light.positionWS[eyeIndex]" _begin)
    if(_begin LESS 0)
        message(FATAL_ERROR "Missing production ${_consumer} light direction")
    endif()
    if(_consumer STREQUAL "Water")
        set(_end_marker "specularLighting += lightColor * intensityMultiplier * contactShadow;")
    elseif(_consumer STREQUAL "Particle")
        set(_end_marker "propertyColor += lightColor;")
    else()
        set(_end_marker "propertyColor += ApplyParticlePointInfluence(lightColor);")
    endif()
    string(SUBSTRING "${_source}" ${_begin} -1 _tail)
    string(FIND "${_tail}" "${_end_marker}" _end)
    string(LENGTH "${_end_marker}" _end_length)
    if(_end LESS 0)
        message(FATAL_ERROR "Missing production ${_consumer} light contribution")
    endif()
    math(EXPR _length "${_end} + ${_end_length}")
    string(SUBSTRING "${_tail}" 0 ${_length} _body)
    if(_consumer STREQUAL "Water")
        string(FIND "${_body}" "float contactShadow = 1.0;" _contact)
        string(FIND "${_body}" "const bool isPointLightLinear" _colour)
        if(_contact LESS 0 OR _colour LESS_EQUAL _contact)
            message(FATAL_ERROR "Missing Water contact-shadow boundaries")
        endif()
        string(SUBSTRING "${_body}" 0 ${_contact} _prefix)
        string(SUBSTRING "${_body}" ${_colour} -1 _suffix)
        set(_body "${_prefix}float contactShadow = 1.0;\n${_suffix}")
    endif()
    set(_zero_exit "if \\(intensityMultiplier == 0\\.0\\)[\n\t ]+continue")
    string(REGEX MATCHALL "${_zero_exit}" _exits "${_body}")
    list(LENGTH _exits _exit_count)
    if(NOT _exit_count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one ${_consumer} zero exit for the reference comparison")
    endif()
    string(REGEX REPLACE "${_zero_exit};"
        "#if !defined(ZERO_ATTENUATION_REFERENCE)\nif (intensityMultiplier == 0.0) continue;\n#endif" _body "${_body}")
    set("${_consumer}_BODY" "${_body}")
endforeach()
file(READ "${PROJECT_ROOT}/package/Shaders/Effect.hlsl" _effect)
extract_between("${_effect}" "bool IsParticleEffect()" "\nbool UseParticleLightingInfluence" particle_effect.hlsli)
extract_between("${_effect}" "float3 ApplyParticlePointInfluence(float3 color)" "\nbool UseAmbientEffectLighting" particle_point_influence.hlsli)
file(READ "${OUTPUT_DIRECTORY}/particle_effect.hlsli" EFFECT_CLASSIFICATION)
file(READ "${OUTPUT_DIRECTORY}/particle_point_influence.hlsli" EFFECT_INFLUENCE)
configure_file("${PROJECT_ROOT}/tests/zero_attenuation.hlsl.in"
    "${OUTPUT_DIRECTORY}/zero_attenuation.hlsl" @ONLY)
