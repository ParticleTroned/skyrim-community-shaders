#define LIGHTING
#define LL_COLOR_ADJUSTMENTS_USE_EXTRA_FLAGS
#include "Common/Color.hlsli"
#include "Common/PBRMath.hlsli"

cbuffer Samples : register(b0)
{
	float4 colors[8];
	float4 glowColors[8];
	float4 vertexColors[8];
	uint4 mappedParameters;
};
RWTexture2D<float4> Result : register(u0);

// Compare production composition against the original gamma round trip using identical graded inputs.
float3 ReferenceEmission(float3 emission, float3 glow, float3 vertexColor, uint flags)
{
	emission = Color::EmitColor(emission);
	bool hasGlowmap = (0x3F & (Permutation::PixelShaderDescriptor >> 24)) == Permutation::LightingTechnique::Glowmap;
#if defined(TRUE_PBR)
	hasGlowmap = hasGlowmap || ((flags & PBR::Flags::HasEmissive) != 0);
#endif
	if (!hasGlowmap)
		return emission;
	glow = Color::Glowmap(glow);
	float3 vertexTint = 1;
#if defined(TRUE_PBR)
	vertexTint = Color::SrgbToLinear(vertexColor);
	float vertexAO = max(max(vertexTint.r, vertexTint.g), vertexTint.b);
	vertexTint = vertexAO == 0.0 ? 1.0 : vertexTint * lerp(1 / max(vertexAO, 1e-4), 1, SharedData::truePBRSettings.VertexAOStrength);
#endif
	if (Color::UseLinearLightingColorAdjustments())
		return emission * glow * vertexTint;
	return Color::LinearToSrgb(Color::SrgbToLinear(emission) * Color::SrgbToLinear(glow) * vertexTint);
}

// Texture sampling is deterministic; the extracted block retains the production selection and composition.
#define MESH_TV_COLOR(result, texture, sampler, uv) result = glowSampleInput
[numthreads(8, 1, 1)] void main(uint3 id : SV_DispatchThreadID)
{
	float3 EmitColor = colors[id.x].rgb;
	float4 glowSampleInput = glowColors[id.x];
	struct Input { float4 Color; };
	Input input;
	input.Color = vertexColors[id.x];
	uint PBRFlags = mappedParameters.x;
@MAPPED_EMISSION@
	float3 reference = ReferenceEmission(EmitColor, glowSampleInput.rgb, input.Color.rgb, PBRFlags);
	float3 relativeError = abs(emitColor - reference) / max(abs(reference), 1.0);
	bool finite = all(isfinite(emitColor)) && all(isfinite(reference));
	Result[id.xy] = float4(emitColor, finite ? max(max(relativeError.r, relativeError.g), relativeError.b) : 1.0);
}
