#pragma once

#include <string_view>
#include <BuildProvenance.generated.h>

namespace Plugin
{
	using namespace std::literals;

	inline constexpr REL::Version VERSION
	{
		// clang-format off
		@PROJECT_VERSION_MAJOR@u,
		@PROJECT_VERSION_MINOR@u,
		@PROJECT_VERSION_PATCH@u,
		// clang-format on
	};

	inline constexpr auto NAME = "@PROJECT_NAME@"sv;
	inline constexpr auto DISPLAY_NAME = "Community Shaders Expanded (CSX)"sv;
	inline constexpr auto FORK_VERSION = "CSX @CSX_VERSION@"sv;
	inline constexpr auto VERSION_LABEL = "CSX @CSX_VERSION@"sv;
	inline constexpr auto MENU_TITLE = "Community Shaders Expanded (CSX) @CSX_VERSION@"sv;

	/// Full git describe string, e.g. "v1.4.11", "v1.4.11-3-gabcdef1", "v1.4.11-3-gabcdef1-dirty".
	/// Matches "v{VERSION}" exactly on a clean tagged release build.
	inline constexpr auto BUILD_DESCRIBE = CSX::EmbeddedBuildProvenance::SOURCE_DESCRIBE;
	inline constexpr auto BUILD_ID = CSX::EmbeddedBuildProvenance::BUILD_ID;
	inline constexpr auto BUILD_ID_SHORT = CSX::EmbeddedBuildProvenance::BUILD_ID_SHORT;
	inline constexpr auto SHADER_CACHE_ABI_ID = CSX::EmbeddedBuildProvenance::SHADER_CACHE_ABI_ID;
}
