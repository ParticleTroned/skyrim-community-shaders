if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()
file(READ "${PROJECT_ROOT}/src/Features/ScreenshotFeature.cpp" _source)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
function(extract_framing_region start end output)
    string(FIND "${_source}" "${start}" _start)
    string(FIND "${_source}" "${end}" _end)
    if(_start EQUAL -1 OR _end LESS _start)
        message(FATAL_ERROR "Screenshot framing test cannot find ${start}")
    endif()
    math(EXPR _length "${_end} - ${_start}")
    string(SUBSTRING "${_source}" ${_start} ${_length} _region)
    set(${output} "${_region}" PARENT_SCOPE)
endfunction()
extract_framing_region("constexpr uint32_t kFramedEyeOutputWidth" "bool IsFramedCapture(" _constants)
extract_framing_region("bool IsEightBitPerComponentFormat(" "float LinearToSrgb(" _framing)
file(WRITE "${OUTPUT_DIRECTORY}/screenshot_framing_under_test.h" "${_constants}\n${_framing}")
