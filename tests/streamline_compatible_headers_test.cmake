cmake_minimum_required(VERSION 4.2)

foreach(_required IN ITEMS PROJECT_ROOT TEST_ROOT TEST_GENERATOR)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "${_required} is required")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _run)
set(_root "${TEST_ROOT}/${_run}")
set(_sdk "${_root}/source/extern/Streamline-DX12/include")
file(COPY "${PROJECT_ROOT}/extern/Streamline-DX12/include/" DESTINATION "${_sdk}")
file(WRITE "${_root}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.21)
project(StreamlineHeaderFixture LANGUAGES NONE)
add_subdirectory("${CSX_ROOT}/cmake/Streamline" "${CMAKE_BINARY_DIR}/streamline")
get_target_property(_includes Streamline INTERFACE_INCLUDE_DIRECTORIES)
list(GET _includes 0 _generated)
file(WRITE "${CMAKE_BINARY_DIR}/include-path.txt" "${_generated}")
get_property(_dependencies DIRECTORY "${CSX_ROOT}/cmake/Streamline" PROPERTY CMAKE_CONFIGURE_DEPENDS)
if(NOT "${CMAKE_SOURCE_DIR}/extern/Streamline-DX12/include/sl_pcl.h" IN_LIST _dependencies)
    message(FATAL_ERROR "The patched input must trigger reconfiguration")
endif()
]=])

function(configure_fixture build expected)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -S "${_root}/source" -B "${build}"
            -G "${TEST_GENERATOR}" "-DCSX_ROOT=${PROJECT_ROOT}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
    )
    if(expected STREQUAL "pass")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Header configuration failed: ${output}${error}")
        endif()
    elseif(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "Expected '${expected}': ${output}${error}")
    endif()
endfunction()

file(READ "${_sdk}/sl_pcl.h" _source)
string(REPLACE "\r\n" "\n" _source "${_source}")
foreach(_ending IN ITEMS LF CRLF)
    set(_input "${_source}")
    if(_ending STREQUAL "CRLF")
        string(REPLACE "\n" "\r\n" _input "${_input}")
    endif()
    file(WRITE "${_sdk}/sl_pcl.h" "${_input}")
    file(SHA256 "${_sdk}/sl_pcl.h" _source_hash)
    configure_fixture("${_root}/${_ending}" pass)
    file(READ "${_root}/${_ending}/include-path.txt" _include)
    file(READ "${_include}/sl_pcl.h" _patched)
    if(_patched MATCHES "using to_underlying =" OR NOT _patched MATCHES "constexpr auto to_underlying")
        message(FATAL_ERROR "The generated PCL header must use the portable enum conversion")
    endif()
    file(GLOB _headers RELATIVE "${_sdk}" "${_sdk}/*.h")
    foreach(_header IN LISTS _headers)
        if(NOT _header STREQUAL "sl_pcl.h")
            file(SHA256 "${_sdk}/${_header}" _original_hash)
            file(SHA256 "${_include}/${_header}" _copy_hash)
            if(NOT _original_hash STREQUAL _copy_hash)
                message(FATAL_ERROR "Unmodified SDK header differs: ${_header}")
            endif()
        endif()
    endforeach()
    file(TIMESTAMP "${_include}/sl_pcl.h" _timestamp "%s.%f")
    configure_fixture("${_root}/${_ending}" pass)
    file(TIMESTAMP "${_include}/sl_pcl.h" _reconfigured_timestamp "%s.%f")
    file(SHA256 "${_sdk}/sl_pcl.h" _after_hash)
    if(NOT _source_hash STREQUAL _after_hash OR NOT _timestamp STREQUAL _reconfigured_timestamp)
        message(FATAL_ERROR "Configuration modified the SDK or rewrote an unchanged generated header")
    endif()
    if(_ending STREQUAL "LF")
        set(_first_include "${_include}")
        set(_first_patch "${_patched}")
    elseif(_include STREQUAL _first_include OR NOT _patched STREQUAL _first_patch)
        message(FATAL_ERROR "Build directories must be independent and produce equivalent corrections")
    endif()
endforeach()

file(APPEND "${_sdk}/sl_pcl.h" "\n// Header refresh fixture\n")
configure_fixture("${_root}/LF" pass)
file(READ "${_first_include}/sl_pcl.h" _refreshed)
if(NOT _refreshed MATCHES "Header refresh fixture")
    message(FATAL_ERROR "Updated SDK content was not propagated")
endif()
file(WRITE "${_sdk}/obsolete.h" "// Inventory fixture\n")
configure_fixture("${_root}/LF" pass)
file(REMOVE "${_sdk}/obsolete.h")
configure_fixture("${_root}/LF" pass)
file(READ "${_root}/LF/include-path.txt" _include)
if(EXISTS "${_include}/obsolete.h")
    message(FATAL_ERROR "A removed SDK header remains visible to consumers")
endif()
file(WRITE "${_sdk}/sl_pcl.h" "// Incompatible SDK revision\n")
configure_fixture("${_root}/LF" "Streamline sl_pcl.h changed")
