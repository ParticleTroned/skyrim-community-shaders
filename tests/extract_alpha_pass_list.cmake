if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()
if(NOT DEFINED SOURCE_NAME)
    set(SOURCE_NAME VRAlphaPassListFix)
endif()
if(NOT DEFINED OUTPUT_NAME)
    set(OUTPUT_NAME alpha_pass_list_hooks.h)
endif()
file(READ "${PROJECT_ROOT}/src/EngineFixes/${SOURCE_NAME}.cpp" _source)
string(FIND "${_source}" "namespace ${SOURCE_NAME}" _start)
if(_start EQUAL -1)
    message(FATAL_ERROR "Cannot locate production ${SOURCE_NAME} implementation")
endif()
string(SUBSTRING "${_source}" ${_start} -1 _implementation)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
file(WRITE "${OUTPUT_DIRECTORY}/${OUTPUT_NAME}" "${_implementation}")
