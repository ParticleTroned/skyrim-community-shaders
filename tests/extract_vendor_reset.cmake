if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()
file(READ "${PROJECT_ROOT}/src/Features/Upscaling.cpp" source)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
function(extract start_token end_token output)
    string(FIND "${source}" "${start_token}" start)
    if(start LESS 0)
        message(FATAL_ERROR "Missing vendor-reset boundary: ${start_token}")
    endif()
    string(SUBSTRING "${source}" ${start} -1 tail)
    string(FIND "${tail}" "${end_token}" end)
    if(end LESS 0)
        message(FATAL_ERROR "Missing vendor-reset boundary: ${end_token}")
    endif()
    string(SUBSTRING "${tail}" 0 ${end} body)
    file(WRITE "${OUTPUT_DIRECTORY}/${output}" "${body}\n")
endfunction()
extract("\tbool IsSameTerminalFSRResourceRequest(\n\t\tconst Upscaling::VRRenderScaleTransitionSnapshot& a_controller)\n\t{"
    "\n\tconst char* BoolText" vendor_lifecycle_under_test.h)
extract("bool Upscaling::ApplyPendingVendorRuntimeReset(" "\n\tconst char* context ="
    vendor_reset_under_test.h)
file(APPEND "${OUTPUT_DIRECTORY}/vendor_reset_under_test.h"
    "\t(void)a_context;\n\t(void)latchTerminalFSRFailure;\n\t++resetPathCalls;\n\treturn false;\n}\n")
