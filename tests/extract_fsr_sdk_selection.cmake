if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()
file(READ "${PROJECT_ROOT}/src/Features/Upscaling/FidelityFX.cpp" _fidelity)
file(READ "${PROJECT_ROOT}/src/Features/Upscaling/FidelityFX.h" _header)
file(READ "${PROJECT_ROOT}/src/Features/Upscaling.cpp" _upscaling)
file(READ "${PROJECT_ROOT}/src/Features/Upscaling.h" _settings)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")

function(extract_between source start end output)
    string(FIND "${source}" "${start}" _start)
    if(_start EQUAL -1)
        message(FATAL_ERROR "FSR SDK selection test cannot find ${start}")
    endif()
    string(SUBSTRING "${source}" ${_start} -1 _remaining)
    string(FIND "${_remaining}" "${end}" _end)
    if(_end EQUAL -1)
        message(FATAL_ERROR "FSR SDK selection test cannot find ${end}")
    endif()
    string(SUBSTRING "${_remaining}" 0 ${_end} _extracted)
    file(WRITE "${OUTPUT_DIRECTORY}/${output}" "${_extracted}")
endfunction()

extract_between("${_header}" "static constexpr uint32_t RuntimeAutomaticVersion" "static constexpr std::wstring_view RuntimeUpscalerDllName" "fsr_sdk_versions.h")
extract_between("${_fidelity}" "bool RuntimeProviderMatchesVersion(" "std::string RuntimeProviderDisplayName(" "fsr_version_under_test.h")
extract_between("${_upscaling}" "void ApplyLegacyFsr4RuntimeSelectionMigration(" "void ResetVRSpecificUpscalingSettings(" "fsr_migration_under_test.h")
string(REGEX MATCH "static constexpr [^\n]+ kFsr4RuntimeSelectionSchemaVersion = [^;]+;" _schema "${_settings}")
if(NOT _schema)
    message(FATAL_ERROR "FSR SDK selection test cannot find migration schema")
endif()
file(WRITE "${OUTPUT_DIRECTORY}/fsr_selection_schema.h" "${_schema}\n")

