file(READ "${PROJECT_ROOT}/src/Features/TextureStreaming/LoadHooks.cpp" source)
string(FIND "${source}" "namespace StreamingTextures::LoadHooks" start)
if(start EQUAL -1)
    message(FATAL_ERROR "Missing remembered-load implementation")
endif()
string(SUBSTRING "${source}" ${start} -1 body)
file(WRITE "${OUTPUT_HEADER}" "${body}")
file(READ "${PROJECT_ROOT}/src/Features/TextureStreaming.cpp" source)
string(FIND "${source}" "void TextureStreaming::State::AdoptLoads(" start)
string(FIND "${source}" "void TextureStreaming::State::ObserveTexture(" end)
math(EXPR count "${end} - ${start}")
string(SUBSTRING "${source}" ${start} ${count} body)
get_filename_component(directory "${OUTPUT_HEADER}" DIRECTORY)
file(WRITE "${directory}/streaming_adoption_under_test.h" "${body}")
