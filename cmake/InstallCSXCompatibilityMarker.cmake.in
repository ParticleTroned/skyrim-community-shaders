set(_csx_marker_source "@CSX_COMPATIBILITY_MARKER@")
set(_csx_marker_name "@CSX_COMPATIBILITY_MARKER_NAME@")
set(
    _csx_marker_directory
    "${CMAKE_INSTALL_PREFIX}/SKSE/Plugins/CommunityShaders"
)

if(NOT EXISTS "${_csx_marker_source}")
    message(
        FATAL_ERROR
        "Missing generated CSX compatibility marker: ${_csx_marker_source}"
    )
endif()

file(MAKE_DIRECTORY "${_csx_marker_directory}")
file(GLOB _csx_installed_markers "${_csx_marker_directory}/CSX*.marker")
foreach(_csx_installed_marker IN LISTS _csx_installed_markers)
    get_filename_component(
        _csx_installed_marker_name
        "${_csx_installed_marker}"
        NAME
    )
    if(NOT "${_csx_installed_marker_name}" STREQUAL "${_csx_marker_name}")
        file(REMOVE "${_csx_installed_marker}")
    endif()
endforeach()

file(
    COPY_FILE
    "${_csx_marker_source}"
    "${_csx_marker_directory}/${_csx_marker_name}"
    ONLY_IF_DIFFERENT
)
