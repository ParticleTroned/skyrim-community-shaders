if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
include("${CMAKE_CURRENT_LIST_DIR}/extract_source_region.cmake")
file(READ "${PROJECT_ROOT}/src/Features/VR.cpp" source)
extract_between("${source}" "\tbool CanDrawInterfaceSettings()" "bool VR::OpenFovSettings()" "vr_interface_settings_under_test.h")
file(READ "${OUTPUT_DIRECTORY}/vr_interface_settings_under_test.h" body)
file(WRITE "${OUTPUT_DIRECTORY}/vr_interface_settings_under_test.h" "namespace {\n${body}")
