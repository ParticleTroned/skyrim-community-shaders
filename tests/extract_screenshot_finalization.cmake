if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()
file(READ "${PROJECT_ROOT}/src/Features/ScreenshotApi.cpp" _source)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
set(_output "")
function(extract_finalization_method start closing)
    string(FIND "${_source}" "${start}" _start)
    if(_start EQUAL -1)
        message(FATAL_ERROR "Finalization source start missing: ${start}")
    endif()
    string(SUBSTRING "${_source}" ${_start} -1 _remaining)
    string(FIND "${_remaining}" "${closing}" _end)
    if(_end EQUAL -1)
        message(FATAL_ERROR "Finalization source closing missing: ${start}")
    endif()
    string(LENGTH "${closing}" _closing_length)
    math(EXPR _length "${_end} + ${_closing_length}")
    string(SUBSTRING "${_remaining}" 0 ${_length} _body)
    set(_output "${_output}\n${_body}\n" PARENT_SCOPE)
endfunction()
extract_finalization_method([==[bool IsTerminal(]==] "\n\t}")
extract_finalization_method([==[void ScreenshotApi::AppendEventLocked(]==] "\n}")
extract_finalization_method([==[void ScreenshotApi::TransitionLocked(]==] "\n}")
extract_finalization_method([==[ScreenshotApi::json ScreenshotApi::MakeReceipt(]==] "\n}")
