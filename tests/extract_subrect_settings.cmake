if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()
file(READ "${PROJECT_ROOT}/src/Utils/Subrect.h" _header)
file(READ "${PROJECT_ROOT}/src/Utils/Subrect.cpp" _source)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
string(REPLACE "#include <imgui.h>" "" _header "${_header}")
string(REGEX REPLACE "void DrawEditor\\([^;]*;" "" _header "${_header}")
string(FIND "${_header}" "// Opaque-RGB blend state callback" _header_end)
string(FIND "${_source}" "namespace\n{" _source_begin)
string(FIND "${_source}" "void Controller::DrawEditor(" _source_end)
string(FIND "${_source}" "PixelRegion Controller::GetPixelRegion(" _source_tail)
foreach(_anchor IN ITEMS _header_end _source_begin _source_end _source_tail)
    if(${_anchor} EQUAL -1)
        message(FATAL_ERROR "Crop settings extraction cannot find ${_anchor}")
    endif()
endforeach()
string(SUBSTRING "${_header}" 0 ${_header_end} _types)
math(EXPR _source_length "${_source_end} - ${_source_begin}")
string(SUBSTRING "${_source}" ${_source_begin} ${_source_length} _methods)
string(SUBSTRING "${_source}" ${_source_tail} -1 _tail)
file(WRITE "${OUTPUT_DIRECTORY}/subrect_settings_types.h" "${_types}\n}\n")
file(WRITE "${OUTPUT_DIRECTORY}/subrect_settings_under_test.h" "${_methods}\n${_tail}")
