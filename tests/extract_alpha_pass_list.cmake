if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()
file(READ "${PROJECT_ROOT}/src/EngineFixes/VRAlphaPassListFix.cpp" _source)
string(FIND "${_source}" "namespace VRAlphaPassListFix" _start)
if(_start EQUAL -1)
    message(FATAL_ERROR "Cannot locate production alpha-list implementation")
endif()
string(SUBSTRING "${_source}" ${_start} -1 _implementation)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
file(WRITE "${OUTPUT_DIRECTORY}/alpha_pass_list_hooks.h" "${_implementation}")
