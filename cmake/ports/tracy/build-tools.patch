diff --git a/cmake/GitRef.cmake b/cmake/GitRef.cmake
--- a/cmake/GitRef.cmake
+++ b/cmake/GitRef.cmake
@@ -1,4 +1,12 @@
 function(add_git_ref target)
+    if(DEFINED TRACY_GIT_REF)
+        file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/GitRef.hpp"
+            CONTENT "#pragma once\nnamespace tracy { static inline const char* GitRef = \"@TRACY_GIT_REF@\"; }\n"
+            @ONLY)
+        target_include_directories(${target} PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
+        return()
+    endif()
+
     if(NOT DEFINED GIT_REV)
         set(GIT_REV "HEAD")
     endif()
diff --git a/vcpkg-tools/CMakeLists.txt b/vcpkg-tools/CMakeLists.txt
new file mode 100644
--- /dev/null
+++ b/vcpkg-tools/CMakeLists.txt
@@ -0,0 +1,20 @@
+cmake_minimum_required(VERSION 3.25)
+project(TracyTools LANGUAGES C CXX)
+
+set(CMAKE_CXX_STANDARD 20)
+# Shared targets must provide statistics and GUI dependencies to every tool.
+set(NO_STATISTICS OFF)
+set(VENDOR_GUI ${VCPKG_GUI_TOOLS})
+include(../cmake/config.cmake)
+include(../cmake/vendor.cmake)
+include(../cmake/server.cmake)
+
+if(VCPKG_CLI_TOOLS)
+    add_subdirectory(../csvexport csvexport)
+    add_subdirectory(../capture capture)
+    add_subdirectory(../import import)
+    add_subdirectory(../update update)
+endif()
+if(VCPKG_GUI_TOOLS)
+    add_subdirectory(../profiler profiler)
+endif()
