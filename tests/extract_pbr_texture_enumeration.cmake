include("${CMAKE_CURRENT_LIST_DIR}/extract_source_region.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
file(READ "${PROJECT_ROOT}/src/TruePBR/BSLightingShaderMaterialPBRLandscape.h" source)
extract_between("${source}" "inline static constexpr uint32_t NumTiles" "BSLightingShaderMaterialPBRLandscape();" "pbr_texture_constants_under_test.h")
file(READ "${PROJECT_ROOT}/src/TruePBR/BSLightingShaderMaterialPBRLandscape.cpp" source)
string(FIND "${source}" "void BSLightingShaderMaterialPBRLandscape::ReceiveValuesFromRootMaterial(" start)
if(start EQUAL -1)
    message(FATAL_ERROR "Cannot find PBR landscape texture methods")
endif()
string(SUBSTRING "${source}" ${start} -1 methods)
file(WRITE "${OUTPUT_DIRECTORY}/pbr_texture_collection_under_test.h" "${methods}")
file(READ "${PROJECT_ROOT}/src/TruePBR/TextureEnumeration.cpp" source)
string(FIND "${source}" "std::int32_t PBRTextures::ForEach(" start)
if(start EQUAL -1)
    message(FATAL_ERROR "Cannot find PBR texture visitor")
endif()
string(SUBSTRING "${source}" ${start} -1 visitor)
file(WRITE "${OUTPUT_DIRECTORY}/pbr_texture_visitor_under_test.h" "${visitor}")
