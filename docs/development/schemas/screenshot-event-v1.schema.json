{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:csx:devbench:screenshot:event:1",
  "title": "CSX screenshot journal event v1",
  "type": "object",
  "required": ["eventId", "eventIndex", "requestId", "type", "timestampUtc", "payload"],
  "properties": {
    "eventId": { "type": "integer", "minimum": 1 },
    "eventIndex": { "type": "integer", "minimum": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "timestampUtc": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
