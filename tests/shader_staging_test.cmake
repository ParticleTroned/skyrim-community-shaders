cmake_minimum_required(VERSION 4.2)

foreach(_required IN ITEMS PROJECT_ROOT TEST_ROOT TEST_GENERATOR)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "${_required} is required")
    endif()
endforeach()

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _run_id)
set(_source "${TEST_ROOT}/${_run_id}/source")
set(_build "${TEST_ROOT}/${_run_id}/build")
file(MAKE_DIRECTORY "${_source}/cmake")
foreach(_script IN ITEMS CleanupStaleEntries PreservedRuntimePaths)
    configure_file("${PROJECT_ROOT}/cmake/${_script}.cmake" "${_source}/cmake/${_script}.cmake" COPYONLY)
endforeach()
file(WRITE "${_source}/package/Shaders/Water.hlsl" "water shader fixture\n")
file(WRITE "${_source}/package/Shaders/Tests/Excluded.hlsl" "test-only shader\n")
set(_retired_ini "features/CS Utility/Shaders/Features/CSUtility.ini")
file(WRITE "${_source}/${_retired_ini}" "retired utility fixture\n")
file(WRITE "${_source}/features/Adaptive Brightness/Shaders/Features/AdaptiveBrightness.ini" "adaptive balance fixture\n")
file(WRITE "${_source}/features/Wetness Effects/Shaders/Hidden.hlsl" "non-shipped fixture\n")
file(WRITE "${_source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 4.2)
project(ShaderStagingFixture NONE)
set(AIO_DIR "${CMAKE_BINARY_DIR}/aio")
file(GLOB _ALL_FEATURE_PATHS CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/features/*")
set(FEATURE_PATHS ${_ALL_FEATURE_PATHS})
list(FILTER FEATURE_PATHS EXCLUDE REGEX "/Wetness Effects$")
set(AIO_NON_SHIPPED_FEATURE_PACKAGES "Wetness Effects")
set(SKIP_RUNTIME_DOWNLOADS ON)
include("${PROJECT_ROOT}/cmake/ShaderStaging.cmake")
foreach(_target IN ITEMS prepare_shaders validate_changed)
    if(NOT TARGET ${_target})
        message(FATAL_ERROR "Missing standalone target: ${_target}")
    endif()
endforeach()
]=])

function(run_cmake)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" ${ARGN}
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error
    )
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Shader staging failed: ${_output}${_error}")
    endif()
endfunction()

function(check_file relative expected)
    set(_path "${_build}/aio/Shaders/${relative}")
    if(NOT EXISTS "${_path}")
        message(FATAL_ERROR "Missing staged file: ${relative}")
    endif()
    file(READ "${_path}" _actual)
    if(NOT "${_actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "Unexpected staged contents: ${relative}")
    endif()
endfunction()

run_cmake(-S "${_source}" -B "${_build}" -G "${TEST_GENERATOR}" "-DPROJECT_ROOT=${PROJECT_ROOT}"
    -DAUTO_PLUGIN_DEPLOYMENT=ON -DAIO_ZIP_TO_DIST=ON -DSHADER_VALIDATION_INCLUDE_NON_SHIPPED_FEATURES=OFF)
run_cmake(--build "${_build}" --config Release --target prepare_shaders)
check_file("Features/CSUtility.ini" "retired utility fixture\n")
check_file("Water.hlsl" "water shader fixture\n")
if(EXISTS "${_build}/aio/Shaders/Tests/Excluded.hlsl" OR EXISTS "${_build}/aio/Shaders/Hidden.hlsl")
    message(FATAL_ERROR "Staging included excluded shader files")
endif()
file(TIMESTAMP "${_build}/aio/Shaders/Water.hlsl" _original_timestamp "%s.%f")

# Reconfiguring with packaging disabled must replace the retired copy recipe.
file(REMOVE "${_source}/${_retired_ini}")
run_cmake(-S "${_source}" -B "${_build}" -DAUTO_PLUGIN_DEPLOYMENT=OFF -DAIO_ZIP_TO_DIST=OFF
    -DSHADER_VALIDATION_INCLUDE_NON_SHIPPED_FEATURES=ON)
run_cmake(--build "${_build}" --config Release --target prepare_shaders)
check_file("Features/AdaptiveBrightness.ini" "adaptive balance fixture\n")
check_file("Hidden.hlsl" "non-shipped fixture\n")
if(EXISTS "${_build}/aio/Shaders/Features/CSUtility.ini")
    message(FATAL_ERROR "Retired feature config survived staging")
endif()
file(TIMESTAMP "${_build}/aio/Shaders/Water.hlsl" _current_timestamp "%s.%f")
if(NOT _original_timestamp STREQUAL _current_timestamp)
    message(FATAL_ERROR "Unchanged shader was unnecessarily rewritten")
endif()

set(_build "${TEST_ROOT}/${_run_id}/fresh")
run_cmake(-S "${_source}" -B "${_build}" -G "${TEST_GENERATOR}" "-DPROJECT_ROOT=${PROJECT_ROOT}"
    -DAUTO_PLUGIN_DEPLOYMENT=OFF -DAIO_ZIP_TO_DIST=OFF)
run_cmake(--build "${_build}" --config Release --target prepare_shaders)
check_file("Features/AdaptiveBrightness.ini" "adaptive balance fixture\n")
message(STATUS "Standalone shader staging passed fresh, reconfigured, retired-feature, and unchanged-file checks")
