file(READ "${PROJECT_ROOT}/src/Presets/LookSceneRuntime.cpp" source)
string(FIND "${source}" "namespace Presets::LookSceneRuntime" start)
if(start EQUAL -1)
    message(FATAL_ERROR "Visuals scene runtime was not found")
endif()
string(SUBSTRING "${source}" ${start} -1 body)
file(WRITE "${OUTPUT_FILE}" "${body}")
file(READ "${PROJECT_ROOT}/src/SceneSettingsManager.cpp" source)
string(FIND "${source}" "std::vector<std::string> SceneSettingsManager::GetInteriorRelevantFeatureNames()" start)
string(FIND "${source}" "std::vector<std::string> SceneSettingsManager::GetFeatureSettingKeys(" end)
if(start EQUAL -1 OR end LESS start)
    message(FATAL_ERROR "Interior feature selection was not found")
endif()
math(EXPR length "${end} - ${start}")
string(SUBSTRING "${source}" ${start} ${length} body)
file(APPEND "${OUTPUT_FILE}" "\n${body}")
